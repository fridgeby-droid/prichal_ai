# Telegram
TELEGRAM_BOT_TOKEN=
# Через запятую: руководитель, операционный директор
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna

# Saby
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
SABY_POINT_IDS=
SABY_MAX_PAGES_PER_POINT=30

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Синхронизация
AUTO_SYNC_ENABLED=true
AUTO_SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=60
SYNC_RECENT_DAYS=3
MAX_MANUAL_SYNC_DAYS=60
SYNC_CONCURRENCY=4

# ShiftEngine
SHIFT_DAY_START_HOUR=8
SHIFT_NIGHT_START_HOUR=20
SHIFT_SESSION_GAP_HOURS=9
SHIFT_MAX_DURATION_HOURS=16
SHIFT_AUTO_SHARE=0.80
SHIFT_AMBIGUOUS_SHARE=0.65

# Причал Core — пока только health-check
CORE_BASE_URL=https://prichalcore.bothost.tech
CORE_API_TOKEN=
CORE_HEALTH_PATH=/health

BUSINESS_TZ=Asia/Yekaterinburg
PORT=8080
LOG_LEVEL=INFO
