# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna

# Saby
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
SABY_POINT_IDS=
SABY_MAX_PAGES_PER_POINT=30

# ============================================================
# Timeweb PostgreSQL
# ============================================================
# DATABASE_URL берём в Timeweb → PostgreSQL → Подключение.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Отдельная схема Причал AI внутри общей БД/кластера.
DB_SCHEMA=prichal_ai

# disable | require | verify-ca | verify-full
DATABASE_SSL_MODE=require

# Для verify-ca / verify-full сертификат Timeweb можно хранить base64.
DATABASE_SSL_CA_B64=
DATABASE_SSL_CA_FILE=

# ============================================================
# Timeweb S3
# ============================================================
S3_ENABLED=true
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Один бакет можно делить между проектами через разные префиксы.
S3_PREFIX=prichal-ai/

# Синхронизация
AUTO_SYNC_ENABLED=false
AUTO_SYNC_ON_START=false
SYNC_INTERVAL_MINUTES=60
SYNC_RECENT_DAYS=3
MAX_MANUAL_SYNC_DAYS=60
SYNC_CONCURRENCY=4
BACKFILL_CHUNK_DAYS=7

# Business day
BUSINESS_DAY_START_HOUR=8

# ShiftEngine
SHIFT_DAY_START_HOUR=8
SHIFT_NIGHT_START_HOUR=20
SHIFT_SESSION_GAP_HOURS=9
SHIFT_MAX_DURATION_HOURS=16
SHIFT_AUTO_SHARE=0.80
SHIFT_AMBIGUOUS_SHARE=0.65
WORK_SHIFT_MERGE_GAP_HOURS=4

# Причал Core
CORE_BASE_URL=https://prichalcore.bothost.tech
CORE_API_TOKEN=
CORE_HEALTH_PATH=/health

BUSINESS_TZ=Asia/Yekaterinburg
PORT=8080
LOG_LEVEL=INFO
